# Publication-style theme + palette (PNAS-like)
theme_pnas <- function(base_size = 13, base_family = "") {
  theme_minimal(base_size = base_size, base_family = base_family) +
    theme(
      plot.title.position = "plot",
      plot.title    = element_text(face = "bold", margin = margin(b = 6)),
      plot.subtitle = element_text(margin = margin(b = 10)),
      plot.caption  = element_text(size = rel(0.9), color = "#5f5f5f", hjust = 1),
      axis.title    = element_text(face = "bold"),
      axis.text     = element_text(color = "#333333"),
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_line(color = "#eaeaea"),
      panel.grid.major.y = element_line(color = "#efefef"),
      legend.position = "top",
      legend.title    = element_text(face = "bold"),
      plot.margin     = margin(8, 8, 8, 8)
    )
}
pol_pal <- c("#1b9e77", "#d95f02", "#7570b3", "#e7298a", "#66a61e", "#e6ab02")
theme_set(theme_pnas())
set.seed(108)

# Handy helpers reused later
P_or <- function(pA, pB, pAB) pA + pB - pAB
bayes_ppv <- function(sens, spec, prev) (sens*prev)/((sens*prev) + (1-spec)*(1-prev))
p_at_least_one <- function(K, N, n) 1 - dhyper(0, K, N-K, n)
```

